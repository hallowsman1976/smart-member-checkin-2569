{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-gas",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tests/gas-harness/server.mjs"],
      "port": 8790
    },
    {
      "name": "mock-gas-seeded",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tests/gas-harness/server.mjs"],
      "env": { "MOCK_SEED_CHECKINS": "640" },
      "port": 8790
    },
    {
      "name": "pages",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "pages:dev"],
      "port": 8788
    }
  ]
}
